# ローカル開発用です。実値を入れた .env / .env.local はGit管理しないでください。
NODE_ENV=development
PORT=3001

# 管理画面 /admin 用のBasic認証
ADMIN_AUTH_USERNAME=<admin-username>
ADMIN_AUTH_PASSWORD=<admin-strong-password>
ADMIN_AUTH_REALM=Sales Basic Rules AI Admin
ADMIN_TITLE=販売基本ルールAI 管理

# 全チャットで共通のBrainAPI接続情報
BRAIN_BASE_URL=https://uat.brain.metaclone.jp
BRAIN_API_KEY=<Brain API Key>

# config/handbooks.json の envPrefix: SEIBU_SOGO に対応
SEIBU_SOGO_BRAIN_PROJECT_ID=<Brain Project ID>
SEIBU_SOGO_BRAIN_CONNECTION_NAME=西部・そごう 販売基本ルールAI Brain

# チャット画面 /chats/seibu-sogo-sales-basic-rules 用のBasic認証
SEIBU_SOGO_AUTH_USERNAME=<chat-username>
SEIBU_SOGO_AUTH_PASSWORD=<chat-strong-password>
SEIBU_SOGO_AUTH_REALM=西部・そごう 販売基本ルールAI

# config/handbooks.json の envPrefix: TOPPAN_GENERIC に対応
TOPPAN_GENERIC_BRAIN_PROJECT_ID=31698489-b2bd-4409-b472-d5cd4027e117
TOPPAN_GENERIC_BRAIN_CONNECTION_NAME=TOPPAN 汎用販売手帳AI Brain

# チャット画面 /chats/toppan-generic-sales-handbook 用のBasic認証
TOPPAN_GENERIC_AUTH_USERNAME=<chat-username>
TOPPAN_GENERIC_AUTH_PASSWORD=<chat-strong-password>
TOPPAN_GENERIC_AUTH_REALM=TOPPAN 汎用販売手帳AI

# 複数ユーザーを許可する場合は *_AUTH_USERNAME / *_AUTH_PASSWORD の代わりに使います。
# ADMIN_AUTH_USERS_JSON=[{"username":"admin1","password":"password1"},{"username":"admin2","password":"password2"}]
# SEIBU_SOGO_AUTH_USERS_JSON=[{"username":"user1","password":"password1"},{"username":"user2","password":"password2"}]

# 任意。通常は管理画面 /admin を使うため false のままで構いません。
HANDBOOK_INDEX_ENABLED=false

# BrainAPIの応答待ち時間。未設定時は180000ミリ秒です。
BRAIN_REQUEST_TIMEOUT_MS=180000
