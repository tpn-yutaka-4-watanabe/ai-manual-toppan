# ローカル開発用です。実値を入れた .env.local はGit管理されません。
NODE_ENV=development
PORT=3001

# config/handbooks.json の envPrefix: SOGO_SEIBU に対応します。
SOGO_SEIBU_BRAIN_BASE_URL=https://uat.brain.metaclone.jp
SOGO_SEIBU_BRAIN_PROJECT_ID=<Brain Project ID>
SOGO_SEIBU_BRAIN_API_KEY=<Brain API Key>
SOGO_SEIBU_BRAIN_CONNECTION_NAME=そごう西武販売手帳AI Brain

# このURL専用のBasic認証です。
SOGO_SEIBU_AUTH_USERNAME=<username>
SOGO_SEIBU_AUTH_PASSWORD=<strong-password>
SOGO_SEIBU_AUTH_REALM=Sogo Seibu Sales Handbook AI

# true の場合だけ、トップページに設定済みアプリのリンクを表示します。
HANDBOOK_INDEX_ENABLED=false

# BrainAPIの応答待ち時間。未設定時は180000ミリ秒です。
BRAIN_REQUEST_TIMEOUT_MS=180000
